      type="button"
      id="filterDropdown"
      data-bs-toggle="dropdown"
      aria-expanded="false"
    >
      <i class="fa-solid fa-filter"></i>
    </button>
    <ul class="dropdown-menu" aria-labelledby="filterDropdown">
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-fire me-2"></i>Trending</a></li>
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-bed me-2"></i>Rooms</a></li>
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-mountain-city me-2"></i>Iconic Cities</a></li>
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-mountain me-2"></i>Mountains</a></li>
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-chess-rook me-2"></i>Castles</a></li>
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-person-swimming me-2"></i>Amazing Pools</a></li>
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-campground me-2"></i>Camping</a></li>
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-cow me-2"></i>Farms</a></li>
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-snowman me-2"></i>Arctic</a></li>
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-igloo me-2"></i>Domes</a></li>
      <li><a class="dropdown-item filter" href="#"><i class="fa-solid fa-ship me-2"></i>Boats</a></li>
    </ul>
  </div>



  <div class="tax-toggle text-center d-none d-lg-flex justify-content-center align-items-center ms-auto">
    <div class="form-check-reverse form-switch ">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
</div>
  </div>



  <div class= "text-center newtax ms-auto mt-2 mt-md-0 fs-6 p-md-3 ">
     <div class="form-check-reverse form-switch ">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault1">
  <label class="form-check-label" for="switchCheckDefault1">Total taxes</label>
  </div>
 </div>

</div>
<!-- row row-cols-1 row-cols-lg-4 row-cols-md-3 row-cols-sm-2 -->
<div class="listings-container ">
    <%for(listing of allListings){%>
    <div class="card listing-card ms-2" >
       
       <a href="/listings/<%= listing._id %>" class="listing-link text-dark">
      <img
        src="<%=listing.image.url %>"
        class="card-img-top frontpg"
        alt="listing_image"
        
      />
     
      <div class="card-body">
        <p class="card-subtitle mb-2 text-body-secondary">
           <h5 class="card-title"><b><%=listing.title %></b></h5>
          <b class="card-price"> &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>/night</b>
          <i class="tax-info"> &nbsp;&nbsp; +18% GST</i>
        </p>
        </div>
      </a>
      <div class="card-img-overlay d-flex justify-content-end align-items-start"><i class="heart fa-regular fa-heart"></i></div>
      </div>

    <% }%>

</div>

<script>
  let toggleLarge = document.getElementById("switchCheckDefault");
  let toggleSmall = document.getElementById("switchCheckDefault1");
  let taxInfo=document.getElementsByClassName("tax-info");
   function toggleTaxInfo() {
    let taxInfo = document.getElementsByClassName("tax-info");
    
    for(info of taxInfo){
      if(info.style.display!="inline"){
        info.style.display="inline";
      }
      else{
        info.style.display="none";
      }
    }
  }
  if (toggleLarge) toggleLarge.addEventListener("click", toggleTaxInfo);
  if (toggleSmall) toggleSmall.addEventListener("click", toggleTaxInfo);
  let hearts =document.querySelectorAll(".heart");
  
hearts.forEach(heart => {
  heart.addEventListener("click", (e) => {
    e.preventDefault();    // stops <a> click event
    e.stopPropagation();   // prevents card redirect

    heart.classList.toggle("fa-regular");
    heart.classList.toggle("fa-solid");
    heart.classList.toggle("text-danger");
  });
});
</script>